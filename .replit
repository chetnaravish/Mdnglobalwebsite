modules = ["nodejs-20", "web", "bash"]
run = "cd artifacts/mdn-school && pnpm install && pnpm dev"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mdn-school && pnpm install && pnpm dev"
waitForPort = 5173

[[ports]]
localPort = 5173
externalPort = 80

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TO_EMAIL = "chetnaravishchetnaravish@gmail.com"
